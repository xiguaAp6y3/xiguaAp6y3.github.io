---
import { CONFESSION_SESSION_KEY } from '@/constants/confession'

const bgImage = '/confession-assets/bg.jpg'
const heroImage = '/confession-assets/photo.jpg'
const bgMusic = '/confession-assets/bgm.mp3'
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>只给你的页面</title>
    <style>
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: 'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system,
          sans-serif;
        color: #fff;
        background:
          linear-gradient(rgba(0, 0, 0, 0.45), rgba(0, 0, 0, 0.45)),
          var(--confession-bg-image) center / cover no-repeat,
          linear-gradient(135deg, #ff7aa2, #ffa4c1 45%, #ffc7d9);
      }
      .card {
        width: min(92vw, 760px);
        text-align: center;
        background: rgba(0, 0, 0, 0.35);
        backdrop-filter: blur(2px);
        border-radius: 20px;
        padding: 30px 24px;
      }
      h1 {
        margin: 0 0 10px;
        font-size: clamp(1.5rem, 3vw, 2rem);
      }
      p {
        margin: 0 0 18px;
        line-height: 1.7;
      }
      .photo {
        width: min(75vw, 340px);
        aspect-ratio: 4 / 5;
        object-fit: cover;
        border-radius: 16px;
        border: 2px solid rgba(255, 255, 255, 0.7);
      }
      .note {
        margin-top: 12px;
        font-size: 0.95rem;
        opacity: 0.9;
      }
      .audio-label {
        margin: 8px 0;
        font-size: 0.95rem;
      }
    </style>
  </head>
  <body style={`--confession-bg-image: url(${bgImage});`}>
    <main class="card">
      <h1>恭喜解锁情人节奶龙［可攻略］</h1>
      <img class="photo" src={heroImage} alt="我们的照片" loading="lazy" />
      <p class="audio-label">背景音乐播放器</p>
      <audio src={bgMusic} loop controls preload="metadata" aria-label="情人节背景音乐播放器">您的浏览器不支持音频播放。</audio>
      <p class="note">奶农正在深情告白</p>
    </main>
    <script is:inline define:vars={{ CONFESSION_SESSION_KEY }}>
      if (sessionStorage.getItem(CONFESSION_SESSION_KEY) !== 'granted') {
        window.location.replace('/confession/')
      }
    </script>
  </body>
</html>
