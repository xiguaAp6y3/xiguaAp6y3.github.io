---
import I18nKey from '@i18n/i18nKey'
import { i18n } from '@i18n/translation'

const repo = import.meta.env.PUBLIC_GISCUS_REPO || 'xiguaAp6y3/xiguaAp6y3.github.io'
const repoId = import.meta.env.PUBLIC_GISCUS_REPO_ID || 'R_kgDOOOOaXQ'
const category = import.meta.env.PUBLIC_GISCUS_CATEGORY || 'Announcements'
const categoryId = import.meta.env.PUBLIC_GISCUS_CATEGORY_ID || 'DIC_kwDOOOOaXc4DCDoK'
const configured = Boolean(repoId && categoryId)
---

<section class="card-base mb-6 p-5 md:p-6" aria-labelledby="giscus-title">
  <h2 id="giscus-title" class="mb-4 text-xl font-bold text-black/85 dark:text-white/85">
    {i18n(I18nKey.comments)}
  </h2>
  {configured ? (
    <div
      data-giscus-container
      data-giscus-repo={repo}
      data-giscus-repo-id={repoId}
      data-giscus-category={category}
      data-giscus-category-id={categoryId}
    ></div>
  ) : (
    <p class="text-sm leading-6 text-black/55 dark:text-white/55">
      评论系统尚未配置 Giscus 的仓库和讨论分类 ID。
    </p>
  )}
</section>
