---
const nextPage = '/confession/second/'
---

<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>小秘密入口</title>
    <style>
      :root {
        color-scheme: light;
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        font-family: 'PingFang SC', 'Microsoft YaHei', system-ui, -apple-system,
          sans-serif;
        background: linear-gradient(135deg, #ff9ac2, #ffd6e8 45%, #fff1f7);
        color: #3a1f2e;
      }
      .panel {
        width: min(90vw, 480px);
        background: rgba(255, 255, 255, 0.92);
        border: 1px solid rgba(255, 255, 255, 0.8);
        border-radius: 20px;
        padding: 28px;
        box-shadow: 0 12px 30px rgba(255, 107, 157, 0.2);
      }
      h1 {
        margin: 0 0 8px;
        font-size: 1.6rem;
      }
      p {
        margin: 0 0 16px;
        line-height: 1.6;
      }
      .chat {
        display: grid;
        gap: 10px;
      }
      label {
        font-size: 0.95rem;
      }
      input {
        width: 100%;
        border: 1px solid #f3b8cd;
        border-radius: 12px;
        padding: 12px;
        font-size: 1rem;
        outline: none;
      }
      input:focus {
        border-color: #ff6b9d;
        box-shadow: 0 0 0 3px rgba(255, 107, 157, 0.18);
      }
      button {
        border: none;
        border-radius: 12px;
        background: #ff6b9d;
        color: #fff;
        font-size: 1rem;
        padding: 12px;
        cursor: pointer;
      }
      #tip {
        min-height: 1.5em;
        margin: 2px 0 0;
        color: #d83a72;
      }
    </style>
  </head>
  <body>
    <main class="panel">
      <h1>给你一个小入口 💌</h1>
      <p>在聊天框输入正确数字，就会进入第二界面。</p>
      <div class="chat">
        <label for="chat-input">聊天输入框</label>
        <input id="chat-input" type="text" placeholder="请输入数字" autocomplete="off" />
        <button id="send-btn" type="button">发送</button>
        <p id="tip" aria-live="polite"></p>
      </div>
    </main>

    <script is:inline define:vars={{ nextPage }}>
      const input = document.getElementById('chat-input')
      const button = document.getElementById('send-btn')
      const tip = document.getElementById('tip')

      const goNext = () => {
        const value = input?.value?.trim()
        if (value === '520') {
          sessionStorage.setItem('confession-pass', 'granted')
          window.location.href = nextPage
          return
        }
        if (tip) tip.textContent = '再想想～提示：是一个很有爱意的数字。'
      }

      button?.addEventListener('click', goNext)
      input?.addEventListener('keydown', event => {
        if (event.key === 'Enter') goNext()
      })
    </script>
  </body>
</html>
